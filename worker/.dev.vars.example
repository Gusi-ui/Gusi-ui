# Copia este archivo a .dev.vars y rellena tus valores reales.
# cp .dev.vars.example .dev.vars
#
# Correo: buzón IONOS por SMTP (smtp.ionos.es:465). SMTP_USER es la dirección completa.
# ADMIN_TOKEN: el mismo que usas en producción (wrangler secret put ADMIN_TOKEN)

SMTP_USER=info@alamia.es
SMTP_PASS=contraseña_del_buzon
ADMIN_TOKEN=tu_token_admin_aqui

# Opcionales (reseñas de Google)
# GOOGLE_API_KEY=
# GOOGLE_PLACE_ID=

# Stripe — pasarela de pagos (obtén las claves en https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta

# Price IDs de Stripe (Dashboard → Productos → Precios)
# Solo el ID, sin prefijos: price_1Ti9t1RqbjGtswoqYQktCguT
STRIPE_PRICE_DESARROLLO_WEB_ONETIME=price_xxxxxxxx
STRIPE_PRICE_OPTIMIZACION_WEB_ONETIME=price_xxx
STRIPE_PRICE_BACKEND_APIS_ONETIME=price_xxx
STRIPE_PRICE_MANTENIMIENTO_MONTHLY=price_xxxxxxxx

# Webhook (Stripe Dashboard → Developers → Webhooks → Signing secret)
# Eventos requeridos: checkout.session.completed, checkout.session.async_payment_succeeded
# Local: stripe listen --forward-to localhost:8787/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Bizum: actívalo en Stripe Dashboard → Settings → Payment methods (solo pagos únicos)
# Customer Portal: Settings → Billing → Customer portal (permitir cancelación de suscripciones)
