---
import ProjectsShowcase from '@/islands/ProjectsShowcase';
import ProjectFilter from '@/islands/ProjectFilter';
import ProjectCard from '@/components/projects/ProjectCard.astro';
import { projects } from '@/data/projects';
import { toDisplayProjects } from '@/lib/projects-display';
import { WHATSAPP_URL } from '@/lib/constants';

interface Props {
  mode?: 'rotating' | 'all';
}

const { mode = 'rotating' } = Astro.props;
const displayProjects = toDisplayProjects(projects);
const Titulo = mode === 'rotating' ? 'h2' : 'h1';
---

<section
  id="proyectos"
  class:list={['apartado', 'proyectos', { 'apartado--pagina': mode === 'all' }]}
  aria-labelledby="proyectos-titulo"
>
  <div class="apartado__contenido">
    <header class="apartado__cabeza">
      <Titulo id="proyectos-titulo" class="apartado__titulo">
        Webs en marcha y demos que puedes probar
      </Titulo>
      <p class="apartado__entrada">
        Webs de clientes que ya están funcionando y proyectos de ejemplo para negocios distintos.
        Ábrelos en el móvil y úsalos, y mira en cada uno cómo se hizo.
      </p>
    </header>

    {
      mode === 'rotating' ? (
        <ProjectsShowcase
          client:visible
          projects={displayProjects}
          whatsappUrl={WHATSAPP_URL}
          visibleCount={3}
          showViewAll={true}
        />
      ) : (
        <>
          <ProjectFilter client:visible />
          <div class="proyectos__rejilla">
            {projects.map((project) => (
              <ProjectCard project={project} whatsappUrl={WHATSAPP_URL} />
            ))}
          </div>
        </>
      )
    }
  </div>
</section>
