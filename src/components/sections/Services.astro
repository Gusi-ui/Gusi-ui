---
import { projectServices, maintenanceService } from '@/data/services';
import ServiceCard from '@/islands/ServiceCard.tsx';
import MaintenanceCard from '@/islands/MaintenanceCard.tsx';
import { isStripeConfigured } from '@/lib/payments/stripe-client';
import { WHATSAPP_URL } from '@/lib/constants';

const stripeEnabled = isStripeConfigured();
---

<section id="servicios" class="apartado" aria-labelledby="servicios-titulo">
  <div class="apartado__contenido">
    <header class="apartado__cabeza">
      <h2 id="servicios-titulo" class="apartado__titulo">Lo que cuesta</h2>
      <p class="apartado__entrada">
        Precios publicados. Puedes contratar y pagar aquí mismo con tarjeta o Bizum, o escribirme
        antes si tienes dudas.
      </p>
    </header>

    <div class="tarifas">
      {
        projectServices.map((service) => (
          <ServiceCard client:visible service={service} stripeEnabled={stripeEnabled} />
        ))
      }
    </div>

    <MaintenanceCard client:visible service={maintenanceService} stripeEnabled={stripeEnabled} />

    <p class="apartado__pie">
      ¿No sabes cuál encaja con lo tuyo?
      <a href={WHATSAPP_URL} target="_blank" rel="noopener">Pregúntame por WhatsApp</a> y te lo
      digo.
    </p>
  </div>
</section>
