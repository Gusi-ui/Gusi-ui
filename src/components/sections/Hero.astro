---
import { WHATSAPP_URL } from '@/lib/constants';
import { conversaciones } from '@/data/conversaciones';
---

<section id="inicio" class="portada" aria-labelledby="portada-titulo">
  <div class="portada__contenido">
    <div class="portada__texto">
      <h1 id="portada-titulo" class="portada__titulo">Cuéntame qué necesita tu negocio.</h1>
      <p class="portada__entrada">
        Te respondo yo, Jose, con un precio y un plazo. Sin reuniones ni formularios eternos.
      </p>
      <div class="portada__acciones">
        <a class="portada__whatsapp" href={WHATSAPP_URL} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1 2.7 11.5 11.5 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.5-.2Z"
            ></path>
          </svg>
          Escribir por WhatsApp
        </a>
        <a class="portada__enlace" href="/servicios/">Ver precios</a>
      </div>
    </div>

    <figure class="portada__chat">
      <figcaption class="portada__chat-aviso">Ejemplo de cómo suele empezar</figcaption>
      {/* Todas las conversaciones ocupan la misma celda: la figura mide lo que la
          más larga y cambiar de una a otra no mueve la página. Sin JavaScript se
          queda la primera. */}
      <div class="portada__conversaciones">
        {
          conversaciones.map((conversacion, i) => (
            <ol
              class="portada__mensajes"
              data-conversacion={conversacion.id}
              data-activa={i === 0 ? '' : undefined}
            >
              {conversacion.mensajes.map((mensaje) => (
                <li class:list={['portada__mensaje', `portada__mensaje--${mensaje.de}`]}>
                  {mensaje.texto.map((trozo) =>
                    typeof trozo === 'string' ? trozo : <strong>{trozo.fuerte}</strong>,
                  )}
                  <span class="portada__hora" aria-hidden="true">
                    {mensaje.hora}
                  </span>
                </li>
              ))}
            </ol>
          ))
        }
      </div>
      {/* Inline y justo aquí para elegir antes del primer pintado: sin parpadeo de
          la primera conversación. Evita repetir la última que vio este visitante. */}
      <script is:inline>
        (() => {
          const listas = document.querySelectorAll('.portada__mensajes');
          if (listas.length < 2) return;
          const CLAVE = 'portada-conversacion';
          let anterior = null;
          try {
            anterior = localStorage.getItem(CLAVE);
          } catch {}
          const candidatas = [...listas].filter((l) => l.dataset.conversacion !== anterior);
          const elegida = candidatas[Math.floor(Math.random() * candidatas.length)];
          listas.forEach((l) => l.toggleAttribute('data-activa', l === elegida));
          try {
            localStorage.setItem(CLAVE, elegida.dataset.conversacion);
          } catch {}
        })();
      </script>
    </figure>
  </div>
</section>
