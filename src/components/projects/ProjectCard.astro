---
import type { ProjectCaseStudy } from '@/data/project-case-studies';
import { getProjectDemoLabel, isExternalDemo } from '@/lib/project-demo';

interface Props {
  project: ProjectCaseStudy;
  whatsappUrl: string;
}

// Mismo marcado que la tarjeta de src/islands/ProjectsShowcase.tsx (home).
const { project, whatsappUrl } = Astro.props;
const whatsappHref = `${whatsappUrl}?text=${encodeURIComponent(project.whatsappMessage)}`;
const externalDemo = isExternalDemo(project.demoUrl);
---

<article class="proyecto" data-project-type={project.type} data-project-id={project.id}>
  <a class="proyecto__imagen" href={`/proyectos/${project.id}/`} tabindex="-1" aria-hidden="true">
    <picture>
      {project.image.avif && <source srcset={`/${project.image.avif}`} type="image/avif" />}
      {project.image.webp && <source srcset={`/${project.image.webp}`} type="image/webp" />}
      <img src={`/${project.image.jpg}`} alt="" loading="lazy" width="1200" height="630" />
    </picture>
  </a>
  <div class="proyecto__cuerpo">
    <p class="proyecto__sector">
      {project.badge}
      <span class="proyecto__estado">{getProjectDemoLabel(project.demoUrl)}</span>
    </p>
    <h3 class="proyecto__titulo">
      <a href={`/proyectos/${project.id}/`}>{project.title}</a>
    </h3>
    <p class="proyecto__resumen">{project.hook}</p>
    <p class="proyecto__resultado">{project.featuredMetric}</p>
    <div class="proyecto__acciones">
      <a href={project.demoUrl} class="proyecto__demo" target="_blank" rel="noopener noreferrer">
        {externalDemo ? 'Visitar la web' : 'Probar la demo'}
      </a>
      <a href={`/proyectos/${project.id}/`} class="proyecto__caso">Cómo se hizo</a>
    </div>
    <p class="proyecto__pie">
      <span>Desde {project.servicePrice} €</span>
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer">Quiero algo parecido</a>
    </p>
  </div>
</article>
