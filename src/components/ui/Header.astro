---
import ThemeToggle from '@/islands/ThemeToggle';
---

<header class="cabecera">
  <div class="cabecera__barra">
    <a href="/" class="cabecera__marca">
      <picture>
        <source srcset="/images/optimizadas/freelancer-icon.avif" type="image/avif" />
        <source srcset="/images/optimizadas/freelancer-icon.webp" type="image/webp" />
        <img
          src="/freelancer-icon-optimizado.png"
          alt=""
          width="36"
          height="36"
          decoding="async"
        />
      </picture>
      <span>alamia.es</span>
    </a>

    <nav id="nav-menu" class="cabecera__menu" aria-label="Navegación principal">
      <a href="/#proyectos">Proyectos</a>
      <a href="/servicios/">Precios</a>
      <a href="/blog/">Blog</a>
      <a href="/#contacto">Contacto</a>
    </nav>

    <div class="cabecera__acciones">
      <ThemeToggle client:load />
      <button
        id="nav-toggle"
        class="cabecera__abrir"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
