---
import SimplePageLayout from '@/layouts/SimplePageLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { WHATSAPP_URL, CONTACT_EMAIL } from '@/lib/constants';
---

<SimplePageLayout
  title="No se pudo enviar el mensaje | alamia.es"
  description="Ha ocurrido un error al enviar tu mensaje."
  noindex
>
  <div class="container checkout-page">
    <div class="checkout-status checkout-status-error">
      <Icon name="exclamation-triangle" />
      <h1>No se pudo enviar el mensaje</h1>
      <p>
        El formulario ha fallado por un problema técnico y tu mensaje no ha llegado. Puedes
        intentarlo otra vez o escribirme directamente.
      </p>
      <p id="error-details" class="checkout-detalle" hidden></p>
      <div class="checkout-actions">
        <a href={WHATSAPP_URL} class="btn btn-whatsapp" target="_blank" rel="noopener">
          Escribir por WhatsApp
        </a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-secondary">Enviar un email</a>
        <a href="/#contacto" class="btn btn-secondary">Volver al formulario</a>
      </div>
    </div>
  </div>
  <script is:inline>
    try {
      const errorData = sessionStorage.getItem('formError');
      if (errorData) {
        const error = JSON.parse(errorData);
        const el = document.getElementById('error-details');
        if (el && error.message) {
          el.textContent = 'Detalle técnico: ' + error.message;
          el.hidden = false;
        }
        sessionStorage.removeItem('formError');
      }
    } catch (e) {}
  </script>
</SimplePageLayout>
