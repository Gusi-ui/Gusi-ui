---
import SimplePageLayout from '@/layouts/SimplePageLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import { graciasPages } from '@/data/gracias';
import { WHATSAPP_URL } from '@/lib/constants';

export function getStaticPaths() {
  return graciasPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---

<SimplePageLayout title={page.title} noindex>
  <div class="container checkout-page">
    <div class="checkout-status checkout-status-success">
      <Icon name="check" />
      <h1>{page.heading}</h1>
      <p>{page.subtitle}</p>

      <section class="checkout-siguiente" aria-labelledby="pasos-titulo">
        <h2 id="pasos-titulo">Qué pasa ahora</h2>
        <ol class="checkout-pasos">
          {
            page.nextSteps.map((step) => (
              <li>
                <Icon name="check" />
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="checkout-actions">
        <a href="/" class="btn btn-primary">Volver al inicio</a>
        <a href={WHATSAPP_URL} class="btn btn-whatsapp" target="_blank" rel="noopener">
          Escribir por WhatsApp
        </a>
      </div>
    </div>
  </div>
</SimplePageLayout>
