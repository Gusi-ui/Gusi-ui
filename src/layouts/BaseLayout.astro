---
import '@/styles/global.css';
import SchemaOrg from '@/components/seo/SchemaOrg.astro';
import CookieConsent from '@/components/ui/CookieConsent.astro';
import { SITE_URL, SITE_NAME } from '@/lib/constants';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = 'Desarrollador Freelance | Jose Martínez - Desarrollo Web & Apps | alamia.es',
  description = 'Desarrollador freelance experto en desarrollo web, aplicaciones móviles y soluciones digitales. Más de 50 proyectos exitosos. Especialista en React, Node.js y SEO.',
  canonical = SITE_URL,
  ogImage = `${SITE_URL}/tu-foto-perfil-optimizada.jpg`,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jose Martínez - alamia.es" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`} />
    <meta name="twitter:site" content="@gusi_dev" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/freelancer-icon-optimizado.png" />

    <!-- Una sola meta, sin media: la gestiona el script de tema de abajo.
         Con dos metas atadas a prefers-color-scheme, el JS escribía sobre la
         variante clara y la barra del navegador ignoraba la elección manual. -->
    <meta name="theme-color" content="#e9f0f6" />

    <script is:inline>
      // Único punto donde se decide el tema, antes del primer pintado.
      // La hoja de estilos ya no tiene @media (prefers-color-scheme), así que
      // la clase .dark de <html> es la referencia para tokens y componentes.
      (function () {
        try {
          const stored = localStorage.getItem('site-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const isDark = stored ? stored === 'dark' : prefersDark;
          document.documentElement.classList.toggle('dark', isDark);
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', isDark ? '#0e1726' : '#e9f0f6');
        } catch (e) {}
      })();
    </script>

    <SchemaOrg />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <CookieConsent />
    <script>
      import '@/scripts/site-init';
    </script>
  </body>
</html>
